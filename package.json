{
  "name": "shardling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shardling, an original 3D momentum-physics platformer for the web",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/reportBundleSize.ts",
    "package": "npm run build && tsx scripts/packageDist.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "validate:levels": "tsx scripts/validateLevels.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:levels"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "postprocessing": "^6.39.2",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/three": "^0.185.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "lil-gui": "^0.21.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
